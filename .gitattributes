# Normalize line endings to LF in the repository. Git converts to the
# platform native ending on checkout; this keeps CI and Windows diffing sane.
* text=auto eol=lf

# Explicitly declare binary files so Git never mangles them.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.pdf binary

# Lockfiles are text but should not be reformatted by formatters.
pnpm-lock.yaml linguist-generated=true
