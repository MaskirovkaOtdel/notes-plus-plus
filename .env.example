# Copy to .env (never commit .env) and adjust as needed.

# Postgres connection string. Leave EMPTY to run the API with an in-memory
# repository (useful for quick local dev and unit tests).
# SECURITY: the notespp/notespp credentials below are development defaults —
# rotate them (strong password, dedicated role) before any shared deployment.
DATABASE_URL=postgres://notespp:notespp@localhost:5432/notespp

# API port
PORT=4000

# API bind address. Safe default: loopback only. Set HOST=0.0.0.0 inside a
# container (the Docker service does) so the port is reachable through the
# container network; anywhere beyond localhost, put a reverse proxy with TLS
# in front.
# HOST=127.0.0.1

# Optional bearer token. When set, every API route except /health requires
# `Authorization: Bearer <token>`. Recommended whenever the API is reachable
# from other machines. Match the web build with VITE_API_TOKEN below.
# NOTESPP_API_TOKEN=change-me

# Optional: serve the built web app from this directory on the API port
# (single-origin deployment). Point at apps/web/dist after `pnpm build`.
# The Docker image sets this automatically.
# WEB_DIST=./apps/web/dist

# Optional: apply the version-controlled SQL migrations (apps/api/drizzle)
# at boot instead of running `pnpm db:push` by hand. The Docker image sets
# this to true.
# MIGRATE_ON_BOOT=true

# Reported by /health and used in release notes.
APP_VERSION=0.0.0

# Web: absolute API base if not using the Vite dev proxy.
# VITE_API_BASE=http://localhost:4000

# Web: bearer token matching NOTESPP_API_TOKEN (baked in at build time).
# VITE_API_TOKEN=change-me
