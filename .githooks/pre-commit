#!/bin/sh
# SVERG v4 Pre-commit pattern audit
FORBIDDEN='(\.env|premium|local|secret|credentials|license-key)'

if git diff --cached --name-only | grep -E -q "$FORBIDDEN"; then
  echo "[SECURITY AUDIT FAILED] Attempting to commit sensitive/airgapped patterns:"
  git diff --cached --name-only | grep -E "$FORBIDDEN"
  exit 1
fi

exit 0
